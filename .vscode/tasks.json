{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-Start Python Backend",
      "type": "shell",
      "command": "npm run backend",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "group": "servers",
        "panel": "split",
        "clear": true
      }
    },
    {
      "label": "Auto-Start Angular Frontend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "group": "servers",
        "clear": true
      }
    }
  ]
}