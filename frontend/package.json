{
  "name": "canto-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart:phone": "node -e \"console.log('Phone access: connect your phone to the same Wi-Fi, then open the Network URL printed by Angular in Chrome (port 4300).')\"",
    "start:phone": "ng serve --host 0.0.0.0 --port 4300 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
