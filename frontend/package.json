{
  "name": "canto-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "cap": "cap",
    "phone:forward": "node scripts/phone-forward.js",
    "backend": "node scripts/backend.js",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prestart:phone": "node scripts/phone-access.js",
    "start:phone": "ng serve --host 0.0.0.0 --port 4300 --proxy-config proxy.conf.json",
    "build": "ng build",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --deps",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:linux:appimage": "tauri build --bundles appimage",
    "build:linux:deb": "tauri build --bundles deb",
    "build:android:apk": "node scripts/build-android.js apk",
    "build:android:aab": "node scripts/build-android.js aab",
    "android:debug": "node scripts/android-debug.js",
    "android:open": "ng build && cap sync android && cap open android",
    "setup:android": "node scripts/setup-android.js",
    "build:windows": "node scripts/build-windows.js",
    "setup:windows": "bash scripts/setup-windows-cross.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@braccato/core": "^1.16.14",
    "@braccato/parsers": "^0.4.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@lucide/angular": "^1.64.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^3.0.0-alpha.5",
    "@types/qrcode": "^1.5.6",
    "daisyui": "^5.7.50",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
